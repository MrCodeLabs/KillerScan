# Match the Markdown line-ending policy in .gitattributes.
[*.md]
end_of_line = lf

# Shared family sources keep the KillerFamily namespace so every app carries the same file.
[{Controls/AccessibilityAudit.cs,Controls/AccessibleControls.cs,Services/InstallerExitCodes.cs}]
dotnet_diagnostic.IDE0130.severity = none
